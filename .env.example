# Copie para .env e preencha. Nunca comite o .env.

# Porta do servidor (Railway injeta automaticamente)
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# String de conexao do PostgreSQL.
# Local:   postgres://postgres:senha@localhost:5432/producao_licitacoes
# Railway: use a referencia ${{Postgres.DATABASE_URL}} no painel de variaveis
DATABASE_URL=postgres://postgres:postgres@localhost:5432/producao_licitacoes

# Force SSL na conexao (necessario ao conectar de fora do Railway)
PGSSL=false

# Segredo de assinatura do JWT. Gere um valor longo e aleatorio.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-em-producao

# Validade do token de sessao
JWT_EXPIRA_EM=12h

# Versao da aplicacao — usada para bust de cache dos assets no deploy.
# Suba este numero a cada deploy (ou deixe vazio para usar a version do package.json).
APP_VERSION=0.1.0

# Senha padrao dos usuarios criados pelo seed (apenas demo)
SEED_SENHA_PADRAO=producao123
